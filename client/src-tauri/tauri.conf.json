{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gw-client",
  "version": "0.1.0",
  "identifier": "com.gawaty.client",
  "license": "MIT",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 网关控制台",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/gw-server"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}